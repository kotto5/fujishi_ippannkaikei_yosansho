{
  "name": "budget-excel-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "explore": "tsx src/explore.ts",
    "parse": "tsx src/1_parse_budget_to_json/main.ts ../inputs/r7.xlsx > r7.json && tsx src/1_parse_budget_to_json/main.ts ../inputs/r8.xlsx > r8.json",
    "merge": "tsx src/2_merge_yearly_budget/main.ts r7.json r8.json > merged.json"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "ts-pattern": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
